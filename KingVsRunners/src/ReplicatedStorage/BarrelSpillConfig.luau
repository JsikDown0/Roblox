-- ═══════════════════════════════════════════════════════════════
-- 🛢️ BarrelSpillConfig — 배럴 액체 지대 공유 상수
--
-- [왜 모듈인가] 이 값들을 서버(BarrelSpillSystem)와 클라(BarrelSlipClient)가
--   둘 다 쓴다. 각 파일에 복사해 두면 한쪽만 고쳤을 때 플레이어와 봇이
--   서로 다른 규칙으로 미끄러진다 — 로그에도 안 남고 재현도 어려운 종류의 버그다.
--
-- ⚠️ 2026-08-26 하루에만 "짝이 맞아야 하는 코드 중 한쪽만 고쳐서" 생긴 버그를
--   여섯 번 잡았다(마법책 성문 훅 / 봇 내구도 / 조준 필터 / grabTrack 해제 /
--   비슈누 부착 / FireClient 가드). 같은 실수를 구조적으로 막으려고 모듈로 뺀다.
--   값은 여기서만 고칠 것.
-- ═══════════════════════════════════════════════════════════════

return {
	-- 웅덩이 크기·수명
	-- 🔺 [밸런스 2026-08-31] 반경 25 → 35.
	--   [왜] 지름 50 이면 러너가 속도 16 으로 약 3.1초 만에 통과한다. 그 3초 안에
	--     봉인이 실제로 물려야 의미가 있는데, 대시는 쿨 6초라 절반은 원래 못 쓰던 상태였다.
	--     35 면 지름 70, 통과 4.4초로 봉인이 걸리는 창이 40% 넓어진다.
	--   [왜 40 이상은 아닌가] 언덕 폭이 245(map1)/248(map2)이라 지름 80 이면 레인을
	--     거의 덮어 "무조건 밟는" 게 된다. 회피 판단이 사라지면 오히려 심심해진다.
	--   ⚠️ DURATION 8 은 일부러 그대로 둔다. 범위와 지속을 같이 늘리면 어느 쪽이
	--     효과인지 분리가 안 된다. 범위만 먼저 보고 부족하면 그때 지속을 만질 것.
	--   ⚠️ 이 값은 서버(BarrelSpillSystem)와 클라(BarrelSlipClient)가 공유한다.
	--     여기서만 바꾸면 양쪽이 자동으로 따라온다 — 다른 곳에 숫자를 박지 말 것.
	RADIUS    = 35,     -- 반경(stud)
	DURATION  = 8,      -- 지속(초)
	THICKNESS = 0.4,    -- 두께 — 지면에 얇게 깔린 느낌
	FADE_TIME = 1.2,    -- 소멸 연출 시간(초)

	-- 판정
	-- ⚠️ HumanoidRootPart 는 발밑보다 약 3 stud 위다. 6 이면 "밟고 있다" 를
	--   커버하면서 위층(다리·언덕)에 선 러너는 걸러진다.
	HEIGHT_SLACK = 6,

	-- 🧊 미끄러짐: 관성 방식.
	-- ⚠️ [실패 기록 2026-08-26] 처음엔 마찰(CustomPhysicalProperties)을 0 에
	--   가깝게 낮췄으나 체감이 거의 없었다. Humanoid 는 WalkSpeed 로 목표 속도를
	--   직접 만들어내므로 지면 마찰을 이겨버린다.
	--   → 속도를 '직전 속도' 쪽으로 끌어당겨 방향 전환 자체를 둔하게 만든다.
	-- 낮을수록 미끄럽다. 0 이면 방향 전환 불가, 1 이면 평소와 동일.
	SLIP_RESPONSE = 0.07,

	-- 🩸 [2026-09-01] 지속 피해(틱뎀).
	--   [왜] 웅덩이가 순수 디버프라 "밟아도 손해가 없다" 였다. 대시·점프 봉인은
	--     쓸 생각이 없던 러너에겐 체감이 0 이라, 결국 그냥 걸어서 지나갔다.
	--   [왜 즉사/다운이 아닌가] 2026-08-26 에 "1히트 1다운" 으로 만들었다가 웅덩이만
	--     밟아도 다운돼서 되돌린 이력이 있다. 배럴은 굴러가며 이미 한 번 때린다.
	--     지속 피해는 그것과 다른 축이다 — 깎아두고 다른 아이템이 마무리하게 한다.
	--   [경로] hum:TakeDamage. processHit 을 타지 않으므로 내구도를 소모하지 않고
	--     "1발사 1히트" 원칙도 그대로다. 마법책·곡사포가 쓰는 것과 같은 경로다.
	--     HP 0 은 ItemDamageSystem.attachRunnerDownOnZero 가 다운으로 바꾼다(즉사 아님).
	--   [수치] 러너 HP 100 기준. 반경 35(지름 70)를 속도 16 으로 통과 = 4.4초 = 44 피해.
	--     한 웅덩이에 끝까지 서 있으면 8초 × 10 = 80 — 혼자서는 못 죽이지만 확실히 아프다.
	--   ⚠️ [2026-09-01 상향] 초당 4 → 10. 4 는 통과 한 번에 17.6(18%)이라 체력바가
	--     거의 안 움직여 "맞고 있다"는 인지가 안 됐다. 대시·점프 봉인만 걸리고
	--     손해가 안 보이니 그냥 걸어서 지나갔다.
	--   ⚠️ 주기도 0.5 → 0.25. 다만 체감 지연의 주범은 주기가 아니라 '전역 누산기'였다 —
	--     들어간 시점과 무관하게 0.5초 격자에 맞춰 일괄 처리해서 첫 피해가 늦게 왔다.
	--     지금은 캐릭터별 타이머라 진입 즉시 1틱이 들어간다(BarrelSpillSystem 참조).
	--   ⚠️ 더 올리기 전에 배럴 명중 횟수를 볼 것 — 실측 1단계 배럴 히트가 판당 2.5회다.
	--     한 판에 웅덩이가 여러 개 깔리면 누적으로 다운이 나기 시작한다.
	TICK_DAMAGE   = 2.5,    -- 1틱당 피해
	TICK_INTERVAL = 0.25,   -- 틱 주기(초) → 초당 10

	-- 🎨 스킨별 액체. 배럴 외형과 내용물이 맞아야 "통이 깨져 쏟아졌다" 로 읽힌다.
	-- ⚠️ 색은 기존 지대들과 겹치지 않게 고른다.
	--   (잔불 주황 / 얼음 하늘색 / 블랙홀 짙은보라 80,20,120)
	LIQUIDS = {
		["Wooden Barrel"]  = { color = Color3.fromRGB(120, 30, 70),   name = "와인", material = Enum.Material.Glass },
		["OilDrum"]        = { color = Color3.fromRGB(25, 22, 20),    name = "기름", material = Enum.Material.Glass },
		["CrusaderBarrel"] = { color = Color3.fromRGB(235, 200, 110), name = "성수", material = Enum.Material.Neon },
	},
	DEFAULT_LIQUID_KEY = "Wooden Barrel",
}
